# Rust
target/
Cargo.lock

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Project specific
*.bak

# ML model binaries (downloaded separately)
*.onnx

# pose_extractor: user-provided video files
pose_extractor/videos/*
!pose_extractor/videos/.gitkeep

# pose_extractor: wizard batch output directories
pose_extractor/results/

# transformer_burn: 学習済み認識モデル(大きい/--train-pose で再生成)
transformer_burn/models/rec_*/
# transformer_burn: build-dict の派生ポーズ辞書
transformer_burn/data/pose_dict*.json
# transformer_burn: 撮影データ・進捗(録画は大きい/index.tsv は再生成可能)
transformer_burn/data/raw_jsl/
# pose_extractor: ライブ認識のデバッグ書き出し(LIVE_DEBUG_DUMP_DIR)の映像フレーム。顔が写るため誤コミットを防ぐ
live_*_frame*_hand-*_palm*.png
# checkpoint クロスバックエンドテストの一時生成物
transformer_burn/tests/temp_checkpoint_test*/

# desktop: GUI アプリ(GPUI)。ビルド成果物は追跡しない。
# 1.0 前の gpui の版を固定するため、ここだけ Cargo.lock を追跡する(上の Cargo.lock の無視を打ち消す)
desktop/target/
!desktop/Cargo.lock

# lan_handoff: LAN 配信ツール。配信される依存を固定するため Cargo.lock を追跡する(上の Cargo.lock の無視を打ち消す)
lan_handoff/target/
!lan_handoff/Cargo.lock
